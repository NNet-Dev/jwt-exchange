# JWT Exchange - Environment Configuration
# Copy this file to .env and fill in the values.
# Required fields are marked with [REQUIRED].

# ---- Inbound IdP Configuration (e.g. Okta, Auth0, Azure AD) ----
# [REQUIRED] Issuer URI of the upstream identity provider
INBOUND_ISSUER_URI=https://your-tenant.okta.com

# F6: Audience validation for inbound tokens (enabled by default).
# [REQUIRED when INBOUND_AUDIENCE_VALIDATION=true] Expected audience value
# in inbound tokens. If not set with validation enabled, startup fails.
INBOUND_AUDIENCE_VALIDATION=true
INBOUND_EXPECTED_AUDIENCE=api://default

# ---- RSA Signing Key ----
# Option A: Explicit paths to existing key files (PEM format)
# RSA_PRIVATE_KEY_PATH=/etc/jwt-exchange/private.pem
# RSA_PUBLIC_CERT_PATH=/etc/jwt-exchange/public.pem

# Option B: Directory for auto-generated keys. If no keys exist in this
# directory, a new RSA-2048 self-signed key pair is generated on first start.
# Subsequent restarts reuse the existing files.
RSA_KEY_PATH=/app/keys

# ---- Downstream Audience ----
# [REQUIRED] JWT audience for the downstream service (e.g. Qlik)
QLIK_AUDIENCE=your-service-audience

# [OPTIONAL] User directory claim. If unset, excluded from JWT payload.
# QLIK_USER_DIRECTORY=QSEFW

# ---- Groups Whitelist ----
# [OPTIONAL] Comma-separated list of group names to forward.
# Groups not in this list are silently excluded.
# If unset, the groups claim is omitted entirely.
# GROUPS_WHITELIST=admins,analysts,developers

# ---- Token Settings ----
# [OPTIONAL] TTL for minted JWT (seconds). Capped at incoming token exp.
# TOKEN_TTL_SECONDS=3600

# ---- Server ----
# [OPTIONAL] Bind address. Default: 0.0.0.0
# LISTEN_HOST=0.0.0.0
# [OPTIONAL] Listen port. Default: 8080
# LISTEN_PORT=8080

# ---- Logging ----
# [OPTIONAL] SQLite database path. Default: ./jwt-exchange.db
# In Docker, use /data/jwt-exchange.db with a mounted volume.
# DB_PATH=./jwt-exchange.db
# [OPTIONAL] Days to retain request logs. Default: 60
# LOG_RETENTION_DAYS=60

# ---- Splunk HEC (optional) ----
# If not set, Splunk export is disabled.
# SPLUNK_HEC_URL=https://splunk:8088/services/collector
# SPLUNK_HEC_TOKEN=your-splunk-hec-token

# F1: TLS verification for Splunk HEC (default: false = strict TLS).
# Set to true ONLY when Splunk uses an internal CA not in the system trust store.
# SPLUNK_HEC_SKIP_TLS_VERIFY=false

# F7: Input validation limits
# [OPTIONAL] Maximum raw token size in bytes. Default: 10000
# MAX_TOKEN_SIZE=10000
# [OPTIONAL] Maximum number of groups in a request. Default: 50
# MAX_GROUPS_COUNT=50
# [OPTIONAL] Maximum group name length. Default: 256
# MAX_GROUP_NAME_LENGTH=256

# ---- Replay Policy ----
# [OPTIONAL] Allow the same JTI to be exchanged twice: once with groups,
# once without. Default: false (strict replay protection — any prior use
# of the JTI blocks all subsequent exchanges).
# ALLOW_REPLAY=false
